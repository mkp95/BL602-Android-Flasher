<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:background="#18232D"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#172A38" android:paddingLeft="6dp" android:paddingRight="6dp"
        android:layout_width="match_parent" android:layout_height="56dp">
        <TextView android:text="BL602" android:textColor="#E8EEF5" android:textStyle="bold"
            android:textSize="18sp" android:gravity="center_vertical"
            android:paddingLeft="4dp" android:layout_width="58dp" android:layout_height="match_parent"/>
        <Button android:id="@+id/connect" android:contentDescription="Connect USB serial"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:insetLeft="0dp" android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="36dp" android:layout_height="40dp"/>
        <Button android:id="@+id/clearTerminal" android:contentDescription="Clear terminal"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:insetLeft="0dp" android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="36dp" android:layout_height="40dp"/>
        <Button android:id="@+id/formatToggle" android:contentDescription="Toggle receive format"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:insetLeft="0dp" android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="36dp" android:layout_height="40dp"/>
        <Button android:id="@+id/autoScroll" android:contentDescription="Toggle auto-scroll"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:insetLeft="0dp" android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="36dp" android:layout_height="40dp"/>
        <Button android:id="@+id/baudControl" android:text="9600" android:contentDescription="UART baud rate"
            android:textAllCaps="false" android:minWidth="0dp" android:minHeight="0dp"
            android:gravity="center" android:paddingLeft="4dp" android:paddingRight="4dp"
            android:insetLeft="0dp" android:insetRight="0dp" android:layout_width="88dp"
            android:layout_height="40dp" android:layout_marginLeft="4dp" android:layout_marginRight="4dp"/>
        <Button android:id="@+id/menu" android:contentDescription="More options"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:insetLeft="0dp" android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="36dp" android:layout_height="40dp"/>
    </LinearLayout>

    <TextView android:id="@+id/status" android:text="●  USB DISCONNECTED" android:textColor="#FF8B8B"
        android:textSize="12sp" android:singleLine="true" android:ellipsize="end"
        android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:background="#263746" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <LinearLayout android:id="@+id/modemStatusRow" android:orientation="horizontal"
        android:gravity="center" android:background="#18232D"
        android:paddingLeft="3dp" android:paddingRight="3dp"
        android:layout_width="match_parent" android:layout_height="40dp">
        <TextView android:id="@+id/rts" android:text="RTS ●" android:gravity="center" android:background="#263746" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:padding="0dp" android:textSize="10sp" android:layout_margin="2dp"/>
        <TextView android:id="@+id/cts" android:text="CTS ●" android:textColor="#E6EDF3" android:gravity="center" android:background="#263746" android:padding="0dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:layout_margin="2dp" android:textSize="10sp"/>
        <TextView android:id="@+id/dtr" android:text="DTR ●" android:gravity="center" android:background="#263746" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:padding="0dp" android:textSize="10sp" android:layout_margin="2dp"/>
        <TextView android:id="@+id/dsr" android:text="DSR ●" android:textColor="#E6EDF3" android:gravity="center" android:background="#263746" android:padding="0dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:layout_margin="2dp" android:textSize="10sp"/>
        <TextView android:id="@+id/cd" android:text="CD ●" android:textColor="#E6EDF3" android:gravity="center" android:background="#263746" android:padding="0dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:layout_margin="2dp" android:textSize="10sp"/>
        <TextView android:id="@+id/ri" android:text="RI ●" android:textColor="#E6EDF3" android:gravity="center" android:background="#263746" android:padding="0dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:layout_margin="2dp" android:textSize="10sp"/>
    </LinearLayout>

    <ScrollView android:id="@+id/flashPanel" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="BL602 firmware images" android:textColor="#F1F5F9" android:textStyle="bold" android:textSize="17sp" android:paddingTop="8dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <LinearLayout android:orientation="horizontal" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/pickFirmware" android:text="＋ BIN" android:contentDescription="Select firmware files" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginRight="4dp"/>
                <Button android:id="@+id/startFlash" android:text="⚡ FLASH" android:contentDescription="Start flashing" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginLeft="4dp"/>
            </LinearLayout>
            <TextView android:id="@+id/firmwareList" android:text="No firmware selected" android:textColor="#F1F5F9" android:textSize="14sp" android:lineSpacingExtra="3dp" android:padding="12dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:background="#203342" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Flash address assignment is not available yet." android:textColor="#B8C4CE" android:textSize="12sp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/flashBack" android:text="← Terminal" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:layout_marginBottom="8dp"/>
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:max="100" android:progress="0" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/flashLog" android:text="Flash log" android:textColor="#F1F5F9" android:padding="12dp" android:textIsSelectable="true" android:background="#14212B" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/monitorPanel" android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/terminalScroll" android:fillViewport="true" android:background="#18232D"
            android:scrollbars="vertical" android:fadeScrollbars="false"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:id="@+id/terminal" android:textColor="#E0E0E0" android:typeface="monospace"
                android:textSize="13sp" android:padding="8dp" android:textIsSelectable="true"
                android:gravity="top|start" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </ScrollView>
        <HorizontalScrollView android:scrollbars="none" android:layout_width="match_parent" android:layout_height="56dp">
            <LinearLayout android:id="@+id/shortcutRow" android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="wrap_content" android:layout_height="match_parent">
                <Button android:id="@+id/m1" android:text="M1" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
                <Button android:id="@+id/m2" android:text="M2" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
                <Button android:id="@+id/m3" android:text="M3" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
                <Button android:id="@+id/m4" android:text="M4" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
                <Button android:id="@+id/m5" android:text="M5" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
                <Button android:id="@+id/m6" android:text="M6" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
                <Button android:id="@+id/m7" android:text="M7" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingLeft="6dp" android:paddingRight="6dp"
            android:layout_width="match_parent" android:layout_height="58dp">
            <EditText android:id="@+id/sendText" android:hint="Enter command" android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" android:singleLine="true" android:backgroundTint="#BBBBBB"
                android:imeOptions="actionSend" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
            <Button android:id="@+id/send" android:text="➤" android:contentDescription="Send command" android:textSize="24sp"
                android:layout_width="58dp" android:layout_height="match_parent" android:layout_marginLeft="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/settingsPanel" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="UART settings" android:textColor="#F1F5F9" android:textSize="17sp" android:textStyle="bold" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Baud rate is selected from the top toolbar." android:textColor="#FFFFFF" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/baudRate" android:visibility="gone" android:inputType="number" android:text="500000" android:hint="Custom baud rate" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Receive format" android:textColor="#FFFFFF" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/viewMode" android:background="#263746" android:popupBackground="#203342" android:layout_width="match_parent" android:layout_height="48dp"/>
            <TextView android:text="Transmit newline" android:textColor="#FFFFFF" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/newlineMode" android:background="#263746" android:popupBackground="#203342" android:layout_width="match_parent" android:layout_height="48dp"/>
            <TextView android:text="Data: 8 bits · Parity: none · Stop: 1" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Tap RTS/DTR to toggle output lines. CTS/DSR/CD/RI are status indicators." android:textColor="#CCCCCC" android:textStyle="bold" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/backToTerminal" android:text="← Terminal" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp"/>
            <TextView android:text="Manual reset: hold BOOT, pulse RESET, release RESET, then release BOOT. Wiring varies by board." android:textColor="#CCCCCC" android:textSize="12sp" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>