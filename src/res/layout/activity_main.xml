<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:background="#303030"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#287D35" android:paddingLeft="12dp" android:paddingRight="8dp"
        android:layout_width="match_parent" android:layout_height="56dp">
        <TextView android:id="@+id/title" android:text="☰" android:textColor="#FFFFFF"
            android:textSize="26sp" android:gravity="center" android:layout_width="48dp" android:layout_height="match_parent"/>
        <TextView android:text="Terminal" android:textColor="#FFFFFF" android:textSize="22sp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/connect" android:text="▶" android:textColor="#FFFFFF"
            android:backgroundTint="#287D35" android:minWidth="44dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/disconnect" android:text="■" android:textColor="#FFFFFF"
            android:backgroundTint="#287D35" android:minWidth="44dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/menu" android:text="⋮" android:textColor="#FFFFFF"
            android:textSize="24sp" android:backgroundTint="#287D35" android:minWidth="40dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:id="@+id/status" android:text="USB disconnected" android:textColor="#FFB4AB"
        android:paddingLeft="12dp" android:paddingTop="3dp" android:paddingBottom="3dp"
        android:background="#287D35" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <HorizontalScrollView android:scrollbars="none" android:background="#303030"
        android:layout_width="match_parent" android:layout_height="52dp">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingLeft="4dp" android:paddingRight="4dp"
            android:layout_width="wrap_content" android:layout_height="match_parent">
            <Button android:id="@+id/rts" android:text="RTS" android:layout_width="64dp" android:layout_height="44dp" android:layout_marginRight="6dp"/>
            <TextView android:id="@+id/cts" android:text="CTS" android:textColor="#BBBBBB" android:gravity="center" android:background="#555555" android:layout_width="64dp" android:layout_height="44dp" android:layout_marginRight="6dp"/>
            <Button android:id="@+id/dtr" android:text="DTR" android:layout_width="64dp" android:layout_height="44dp" android:layout_marginRight="6dp"/>
            <TextView android:id="@+id/dsr" android:text="DSR" android:textColor="#BBBBBB" android:gravity="center" android:background="#555555" android:layout_width="64dp" android:layout_height="44dp" android:layout_marginRight="6dp"/>
            <TextView android:id="@+id/cd" android:text="CD" android:textColor="#BBBBBB" android:gravity="center" android:background="#555555" android:layout_width="64dp" android:layout_height="44dp" android:layout_marginRight="6dp"/>
            <TextView android:id="@+id/ri" android:text="RI" android:textColor="#BBBBBB" android:gravity="center" android:background="#555555" android:layout_width="64dp" android:layout_height="44dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView android:id="@+id/flashPanel" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="BL602 firmware images" android:textColor="#FFFFFF" android:textStyle="bold" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/pickFirmware" android:text="Select BIN file(s)" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/firmwareList" android:text="No firmware selected" android:textColor="#FFFFFF" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Flash address assignment is not available yet." android:textColor="#CCCCCC" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/startFlash" android:text="FLASH BL602" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:max="100" android:progress="0" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/flashLog" android:text="Flash log" android:textColor="#FFFFFF" android:padding="8dp" android:textIsSelectable="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/monitorPanel" android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/terminalScroll" android:fillViewport="true" android:background="#303030"
            android:scrollbars="vertical" android:fadeScrollbars="false"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:id="@+id/terminal" android:textColor="#E0E0E0" android:typeface="monospace"
                android:textSize="13sp" android:padding="8dp" android:textIsSelectable="true"
                android:gravity="top|start" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </ScrollView>
        <HorizontalScrollView android:scrollbars="none" android:layout_width="match_parent" android:layout_height="56dp">
            <LinearLayout android:id="@+id/shortcutRow" android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="wrap_content" android:layout_height="match_parent">
                <Button android:id="@+id/m1" android:text="M1" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
                <Button android:id="@+id/m2" android:text="M2" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
                <Button android:id="@+id/m3" android:text="M3" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
                <Button android:id="@+id/m4" android:text="M4" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
                <Button android:id="@+id/m5" android:text="M5" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
                <Button android:id="@+id/m6" android:text="M6" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
                <Button android:id="@+id/m7" android:text="M7" android:layout_width="48dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingLeft="6dp" android:paddingRight="6dp"
            android:layout_width="match_parent" android:layout_height="58dp">
            <EditText android:id="@+id/sendText" android:hint="Enter command" android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" android:singleLine="true" android:backgroundTint="#BBBBBB"
                android:imeOptions="actionSend" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
            <Button android:id="@+id/send" android:text="➤" android:textSize="24sp"
                android:layout_width="58dp" android:layout_height="match_parent" android:layout_marginLeft="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/settingsPanel" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="UART settings" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Baud rate" android:textColor="#FFFFFF" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/baudPreset" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/baudRate" android:visibility="gone" android:inputType="number" android:text="500000" android:hint="Custom baud rate" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Receive format" android:textColor="#FFFFFF" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/viewMode" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Transmit newline" android:textColor="#FFFFFF" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/newlineMode" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Data: 8 bits · Parity: none · Stop: 1" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Tap RTS/DTR to toggle output lines. CTS/DSR/CD/RI are status indicators." android:textColor="#CCCCCC" android:textStyle="bold" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/backToTerminal" android:text="Back to terminal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Manual reset: hold BOOT, pulse RESET, release RESET, then release BOOT. Wiring varies by board." android:textColor="#CCCCCC" android:textSize="12sp" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>